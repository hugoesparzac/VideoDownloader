<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VideoDownloader.App.ViewModels"
        xmlns:models="using:VideoDownloader.App.Models"
        x:Class="VideoDownloader.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Video Downloader"
        Icon="/Assets/app-icon.png"
        Width="800" Height="680"
        MinWidth="620" MinHeight="560">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#14808080" />
      <Setter Property="BorderBrush" Value="#30808080" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24" RowSpacing="16">

    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <Image Grid.Column="0" Source="/Assets/app-icon.png" Width="36" Height="36" />
      <TextBlock Grid.Column="1" Text="Video Downloader"
                 FontSize="24" FontWeight="SemiBold"
                 VerticalAlignment="Center" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                  VerticalAlignment="Center">
        <TextBlock Text="Theme" Classes="label" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Themes}"
                  SelectedItem="{Binding SelectedTheme}"
                  MinWidth="110" />
      </StackPanel>
    </Grid>

    <!-- URL and cookies -->
    <Border Grid.Row="1" Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0"
                   Text="{Binding Url}"
                   PlaceholderText="Paste a video, playlist or post URL">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding AnalyzeCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Grid.Column="1" Content="Analyze"
                  Padding="16,8"
                  Command="{Binding AnalyzeCommand}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Browser cookies" Classes="label" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Browsers}"
                    SelectedItem="{Binding SelectedBrowser}"
                    MinWidth="200"
                    ToolTip.Tip="Only needed for content that requires login (Instagram, some TikTok). On Windows, use Firefox.">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="models:BrowserOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Result and options -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                  IsVisible="{Binding MediaTitle, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="card">
        <StackPanel Spacing="16">

          <TextBlock Text="{Binding MediaTitle}"
                     FontSize="16" FontWeight="SemiBold"
                     TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Spacing="16"
                      IsVisible="{Binding !IsImagePost}">
            <StackPanel Spacing="4">
              <TextBlock Text="Format" Classes="label" />
              <ComboBox ItemsSource="{Binding Kinds}"
                        SelectedItem="{Binding SelectedKind}"
                        MinWidth="140" />
            </StackPanel>

            <StackPanel Spacing="4" IsVisible="{Binding IsVideoSelected}">
              <TextBlock Text="Resolution" Classes="label" />
              <ComboBox ItemsSource="{Binding AvailableResolutions}"
                        SelectedItem="{Binding SelectedResolution}"
                        MinWidth="180">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="models:ResolutionOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Save to" Classes="label" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" Text="{Binding OutputFolder}" />
              <Button Grid.Column="1" Content="Browse..."
                      Command="{Binding BrowseFolderCommand}" />
            </Grid>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Download" Classes="accent"
                    MinWidth="120" Padding="16,8"
                    Command="{Binding DownloadCommand}" />
            <Button Content="Cancel" Padding="16,8"
                    Command="{Binding CancelDownloadCommand}"
                    IsVisible="{Binding IsDownloading}" />
          </StackPanel>

          <StackPanel Spacing="4" IsVisible="{Binding HasFailures}">
            <TextBlock Text="Skipped items" Classes="label" />
            <ScrollViewer MaxHeight="140">
              <ItemsControl ItemsSource="{Binding FailedItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>

        </StackPanel>
      </Border>
    </ScrollViewer>

    <!-- Status and tools -->
    <Border Grid.Row="3" Classes="card">
      <StackPanel Spacing="8">
        <ProgressBar Maximum="100"
                     Value="{Binding ProgressPercent}"
                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                     IsVisible="{Binding IsBusy}" />
        <TextBlock Text="{Binding ProgressText}" Opacity="0.8"
                   IsVisible="{Binding IsDownloading}" />
        <TextBlock Text="{Binding StatusMessage}" Opacity="0.9"
                   TextWrapping="Wrap" />

        <Border BorderThickness="0,1,0,0" BorderBrush="#30808080" Padding="0,10,0,0">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <TextBlock Grid.Column="0"
                       Text="{Binding ToolsStatus}"
                       Classes="label"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <CheckBox Grid.Column="1"
                      Content="Update tools on startup"
                      IsChecked="{Binding CheckUpdatesOnStartup}" />
            <Button Grid.Column="2" Content="Update tools"
                    Command="{Binding UpdateToolsCommand}" />
          </Grid>
        </Border>
      </StackPanel>
    </Border>

  </Grid>
</Window>
